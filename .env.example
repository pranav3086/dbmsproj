# ─────────────────────────────────────────────────────────────────────────────
# A10 Hospital (MySQL) — optional settings. Copy to .env to change them.
# The defaults below are for the project's own local MySQL server only.
# ─────────────────────────────────────────────────────────────────────────────

# MySQL server started by `npm run db:server` (listens on 127.0.0.1 only)
DB_HOST=127.0.0.1
DB_PORT=3307
DB_ROOT_PASSWORD=A10root#2026

# The application's MySQL account (created by `npm run db:setup`). It can only read the
# a10_api security views and run the granted stored procedures.
DB_APP_USER=a10_app
DB_APP_PASSWORD=A10app#2026

# API server
API_PORT=3001
# Set to "off" to disable /api/dev (simulated mailbox, reset) — do this for any real deployment
DEV_TOOLS=on

# Password given to the demo accounts by `npm run db:setup`
DEMO_PASSWORD=DemoCare#2026

# Optional: folder of a different MySQL installation's bin directory
# MYSQL_BIN=C:/Program Files/MySQL/MySQL Server 8.4/bin

# Website: set to "off" to hide demo accounts and the mailbox link
VITE_DEMO_TOOLS=on
VITE_HOSPITAL_TIMEZONE=Asia/Kolkata
